generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROCUREMENT
  SALES
  CUSTOMER
}

enum CertType {
  ANNUAL
  PER_PRODUCTION
  ANNUAL_REGULAR_PER_PRODUCTION_PESACH // לימות השנה שנתי, לפסח לפי יצור
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LinkDocType {
  RABBINATE
  BADATZ_CERT
  BADATZ_REPORT
  DOCUMENT
}

enum BadatzDocType {
  CERT
  PRODUCTION_REPORT
}

enum RequestChannel {
  EMAIL
  WHATSAPP
}

enum RequestStatus {
  PENDING
  SENT
  FAILED
}

// ── Raw-material approval registry (added 1.11.2026, additive migration) ──
enum RawMaterialDocRole {
  LABEL
  BACK_LABEL
  ANALYSIS
  CERT
  SPEC
  OTHER
}

enum RawMaterialApprovalStatus {
  NOT_SENT
  SENT_PENDING
  APPROVED
  REJECTED
  CONDITIONAL
}

enum RawMaterialEventType {
  SENT
  REPLY
  STATUS_CHANGE
  NOTE
}

// Pesach approval lives as fields on the same RawMaterialApproval row, not
// a separate kashrut body -- only bodies with handlesPassover=true use this.
enum PassoverStatus {
  NOT_ASKED
  PASSOVER
  PASSOVER_KITNIYOT
  NOT_PASSOVER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role     @default(ADMIN)
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  uploadedDocuments Document[]     @relation("uploadedBy")
  reviewedLinks     SkuLink[]      @relation("reviewedBy")
  requestedCerts    CertRequest[]  @relation("requestedBy")
  fulfilledCerts    CertRequest[]  @relation("fulfilledBy")

  updatedRawMaterialApprovals RawMaterialApproval[]
  rawMaterialApprovalEvents   RawMaterialApprovalEvent[]
}

model Customer {
  id          Int    @id @default(autoincrement())
  name        String
  contactInfo String?
  users       User[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  skus Sku[]
}

model Sku {
  id               Int       @id @default(autoincrement())
  code             String    @unique // מק"ט
  name             String
  categoryId       Int?
  category         Category? @relation(fields: [categoryId], references: [id])
  supplier         String?
  supplier2        String?
  tipus            String?
  sourceFlag       String?
  responsible      String?
  certType         CertType?
  kashrutBodyRef   String?
  pesachStatusRef  String?
  notes            String?
  active           Boolean   @default(true)

  // provenance / new-SKU detection
  origin           String[]  @default([])
  firstSeenAt      DateTime  @default(now())
  reviewedAt       DateTime?
  updatedAt        DateTime  @updatedAt

  links            SkuLink[]
  certRequests     CertRequest[]
  rawMaterials     SkuRawMaterial[]

  @@index([categoryId])
}

model RabbinateCert {
  id                 Int       @id @default(autoincrement())
  refNumber          String?
  matchedProductText String?
  status             String?
  kashrutBody        String?
  expiryDate         DateTime?
  fileUrl            String?
  createdAt          DateTime  @default(now())

  links SkuLink[]
}

model BadatzDoc {
  id            Int           @id @default(autoincrement())
  docType       BadatzDocType
  kashrutBody   String?
  manufacturer  String?
  productsText  String?
  expiryDate    DateTime?
  fileUrl       String?
  createdAt     DateTime      @default(now())

  links SkuLink[]
}

model Document {
  id             Int       @id @default(autoincrement())
  title          String?
  description    String?
  docType        String?
  docExt         String?
  sizeBytes      Int?
  tags           String[]  @default([])
  fileUrl        String
  expiryDate     DateTime?
  productionDate DateTime?
  hidden         Boolean   @default(false)
  uploadedById   Int?
  uploadedBy     User?     @relation("uploadedBy", fields: [uploadedById], references: [id])
  createdAt      DateTime  @default(now())

  links SkuLink[]
  rawMaterialDocuments   RawMaterialDocument[]
  rawMaterialDefaultFor  RawMaterial[]           @relation("RawMaterialDefaultDoc")
  rawMaterialReplyFor    RawMaterialApproval[]   @relation("RawMaterialApprovalReplyDoc")
}

model SkuLink {
  id                Int             @id @default(autoincrement())
  skuId             Int
  sku               Sku             @relation(fields: [skuId], references: [id])
  docType           LinkDocType
  rabbinateCertId   Int?
  rabbinateCert     RabbinateCert?  @relation(fields: [rabbinateCertId], references: [id])
  badatzDocId       Int?
  badatzDoc         BadatzDoc?      @relation(fields: [badatzDocId], references: [id])
  documentId        Int?
  document          Document?       @relation(fields: [documentId], references: [id])
  approvalStatus    ApprovalStatus  @default(PENDING)
  kashrutLevel      String?         // רמת כשרות שאושרה/נמצאה על גבי התווית (מהדרין / בית יוסף / עדה חרדית וכו')
  isRawMaterial     Boolean         @default(false) // true רק עבור רשומות שנוצרו דרך מסך "ניהול אישור חמרי גלם"
  visibleToCustomer Boolean         @default(false)
  reviewedById      Int?
  reviewedBy        User?           @relation("reviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime        @default(now())

  @@index([skuId])
}

model CertRequest {
  id                Int            @id @default(autoincrement())
  skuId             Int
  sku               Sku            @relation(fields: [skuId], references: [id])
  requestedById     Int
  requestedBy       User           @relation("requestedBy", fields: [requestedById], references: [id])
  recipientName     String?
  channel           RequestChannel
  recipientAddress  String
  status            RequestStatus  @default(PENDING)
  fulfilledById     Int?
  fulfilledBy       User?          @relation("fulfilledBy", fields: [fulfilledById], references: [id])
  fulfilledAt       DateTime?
  createdAt         DateTime       @default(now())
}

// Generic small key/value store for cross-process state that must survive
// Render restarts -- e.g. the Drive watcher's "last checked" timestamp.
model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Free-form contact list for the raw-material send flow (email/WhatsApp) --
// not a fixed predefined list, just names people save for reuse instead of
// retyping the same בד"ץ contact's address/number every time.
model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  // added 1.11.2026 for the raw-material registry; nullable so existing
  // free-form contacts keep working untouched
  kashrutBodyId Int?
  kashrutBody   KashrutBody? @relation("ContactKashrutBody", fields: [kashrutBodyId], references: [id])
  role          String?

  defaultForBodies KashrutBody[]         @relation("KashrutBodyDefaultContact")
  rawMaterialApprovals RawMaterialApproval[]
}

// ── Raw-material approval registry (added 1.11.2026, additive migration) ──
// See docrepo-raw-materials-spec.md. Does not replace SkuLink/isRawMaterial/
// approvalStatus yet -- those keep working until the new screens take over.

model KashrutBody {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  shortName        String?
  active           Boolean  @default(true)
  handlesPassover  Boolean  @default(false)
  sortOrder        Int      @default(100)
  defaultContactId Int?
  defaultContact   Contact? @relation("KashrutBodyDefaultContact", fields: [defaultContactId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts  Contact[]             @relation("ContactKashrutBody")
  approvals RawMaterialApproval[]
}

model RawMaterial {
  id           Int       @id @default(autoincrement())
  name         String
  supplier     String?
  manufacturer String?
  defaultDocId Int?
  defaultDoc   Document? @relation("RawMaterialDefaultDoc", fields: [defaultDocId], references: [id])
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents RawMaterialDocument[]
  approvals RawMaterialApproval[]
  skus      SkuRawMaterial[]
}

model RawMaterialDocument {
  id            Int                @id @default(autoincrement())
  rawMaterialId Int
  rawMaterial   RawMaterial        @relation(fields: [rawMaterialId], references: [id])
  documentId    Int
  document      Document           @relation(fields: [documentId], references: [id])
  docRole       RawMaterialDocRole @default(OTHER)
  uploadedAt    DateTime           @default(now())

  @@index([rawMaterialId])
}

model RawMaterialApproval {
  id            Int                       @id @default(autoincrement())
  rawMaterialId Int
  rawMaterial   RawMaterial               @relation(fields: [rawMaterialId], references: [id])
  kashrutBodyId Int
  kashrutBody   KashrutBody               @relation(fields: [kashrutBodyId], references: [id])
  contactId     Int?
  contact       Contact?                  @relation(fields: [contactId], references: [id])
  status        RawMaterialApprovalStatus @default(NOT_SENT)
  kashrutLevel  String?
  passoverStatus PassoverStatus           @default(NOT_ASKED)
  passoverYear  String?
  passoverNote  String?
  sentAt        DateTime?
  sentVia       RequestChannel?
  sentDocIds    Json?
  replyAt       DateTime?
  replyDocId    Int?
  replyDoc      Document?                 @relation("RawMaterialApprovalReplyDoc", fields: [replyDocId], references: [id])
  conditionText String?
  validUntil    DateTime?
  notes         String?
  updatedById   Int?
  updatedBy     User?                     @relation(fields: [updatedById], references: [id])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  events RawMaterialApprovalEvent[]

  @@unique([rawMaterialId, kashrutBodyId])
}

model RawMaterialApprovalEvent {
  id         Int                        @id @default(autoincrement())
  approvalId Int
  approval   RawMaterialApproval        @relation(fields: [approvalId], references: [id])
  type       RawMaterialEventType
  fromStatus RawMaterialApprovalStatus?
  toStatus   RawMaterialApprovalStatus?
  payload    Json?
  byUserId   Int?
  byUser     User?                      @relation(fields: [byUserId], references: [id])
  at         DateTime                   @default(now())

  @@index([approvalId])
}

model SkuRawMaterial {
  id            Int         @id @default(autoincrement())
  skuId         Int
  sku           Sku         @relation(fields: [skuId], references: [id])
  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  notes         String?
  createdAt     DateTime    @default(now())

  @@unique([skuId, rawMaterialId])
}
